layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for page in site.pages %}{% unless page.path == '404.html' or page.path == 'feed.xml' or page.path == 'sitemap.xml' or page.path == 'robots.txt' %}  <url><loc>{{ page.url | absolute_url }}</loc></url>
{% endunless %}{% endfor %}{% for post in site.posts %}  <url><loc>{{ post.url | absolute_url }}</loc><lastmod>{{ post.date | date_to_xmlschema }}</lastmod></url>
{% endfor %}</urlset>
